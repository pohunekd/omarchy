#!/usr/bin/env python3
"""A stand-in `pohunek` CLI with synthetic sessions on three hosts.

Point the widget at it to try the panel without a daemon, or to take
screenshots that show no real work:

    omarchy bar set pohunek.sessions command ~/.config/omarchy/plugins/pohunek.sessions/tools/demo-pohunek

and back with `omarchy bar set pohunek.sessions command pohunek`. Answers the
read commands the widget uses and the commands tools/onboard calls; anything
else prints what it would do.

The onboarding answers follow pohunek 0.43.0 (zajca/pohunek tag v0.43.0), and
0.42.0 where that release answers differently; the source of each document is
named where it is built. With DEMO_POHUNEK_STATE the projects, profiles,
session metadata, hooks and agent skills are kept there and change with the
write commands, so a run and its undo can be compared. Optional environment,
used by tests/onboard_test.py:

  DEMO_POHUNEK_LOG        file under $TMPDIR: one JSON line per call; also makes
                          unknown commands and flags a usage error (exit 2)
  DEMO_POHUNEK_STATE      directory under $TMPDIR for installed packages,
                          sessions, projects, profiles, hooks and the service
  DEMO_POHUNEK_VERSION    version `--version` reports (default 0.42.0)
  DEMO_POHUNEK_ASSISTANT  assistant entry of the setup plan: gap (default),
                          install or present
  DEMO_POHUNEK_SERVICE    `install` plans a fresh service install until
                          `setup --yes` ran; otherwise the service is present
  DEMO_POHUNEK_NO_HOOKS   1: `setup` does not know `--hooks` (a core before 0.42)
  DEMO_POHUNEK_EXTRA_PROBLEM  1: `setup --yes` also fails a doctor check
  DEMO_POHUNEK_INSTALL_DIGEST  digest `plugin install|update` reports as
                          installed instead of the archive's own
  DEMO_POHUNEK_NO_SKILL   1: `integration status` reports no agent `skill` (a
                          daemon without the skill install)
  DEMO_POHUNEK_PROFILE_CHANGED  name of a profile whose file changes between
                          `plugin profile list` and `create --replace`
  DEMO_POHUNEK_FAIL_PROJECT_RM  1: `project rm` fails
  DEMO_POHUNEK_UNLISTED_RUN  1: `session list --meta-eq onboard.run=...` lists
                          no session (the listing does not show the run's session)
  DEMO_POHUNEK_ATTACH_ENDS  1: `attach` returns once the onboard session ended
                          (the user stayed attached until the agent exited)
  DEMO_POHUNEK_LAUNCH_FAILED  1: `assistant setup` starts the session already
                          `failed`, with `ended_at` set
  DEMO_POHUNEK_LAUNCH_BLOCKED  1: `assistant setup` keeps the session instead
                          (pohunek 0.44.0): `initial_input: pending` and a
                          blocked/permission activity, an agent waiting on a dialog
  DEMO_POHUNEK_LAUNCH_NOT_READY  slow: `assistant setup` fails with the
                          non-blocked `session_input_not_ready` message;
                          blocked_old: the same refusal for a blocked dialog
                          as cores before 0.44.0 word it (startup-grace hint)
"""
import hashlib, json, os, re, shutil, sys, time

args = sys.argv[1:]
host = "local"
if "--host" in args:
    i = args.index("--host")
    host = args[i + 1] if i + 1 < len(args) else "local"
    args = args[:i] + args[i + 2:]
if host in ("workstation",):
    host = "local"

VERSION = os.environ.get("DEMO_POHUNEK_VERSION", "0.42.0")


def at_least(version):
    def parts(v):
        return tuple(int(x) for x in re.match(r"^(\d+)\.(\d+)\.(\d+)", v).groups())
    return parts(VERSION) >= parts(version)


# `plugin profile rm` and `plugin profile list --all` ship in 0.43.0.
HAS_PROFILE_RM = at_least("0.43.0")
PROTOCOL = {"minimum": 5, "maximum": 5}
ASSISTANT_ID = "pohunek.context.assistant"
ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")


def under_tmpdir(path):
    """Test files live under the caller's TMPDIR, nowhere else."""
    tmp = os.environ.get("TMPDIR", "")
    if not path or not tmp:
        return False
    return os.path.realpath(path).startswith(os.path.realpath(tmp) + os.sep)


LOG = os.environ.get("DEMO_POHUNEK_LOG", "")
STATE = os.environ.get("DEMO_POHUNEK_STATE", "")
for name, value in (("DEMO_POHUNEK_LOG", LOG), ("DEMO_POHUNEK_STATE", STATE)):
    if value and not under_tmpdir(value):
        print(f"demo-pohunek: {name} must be under TMPDIR", file=sys.stderr)
        sys.exit(2)
STRICT = bool(LOG)
if LOG:
    with open(LOG, "a", encoding="utf-8") as handle:
        handle.write(json.dumps({"argv": sys.argv[1:], "bin": os.path.realpath(__file__)}) + "\n")


def ago(seconds):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - seconds))


def rfc3339(seconds_ago=0.0):
    """The daemon's timestamps: RFC3339 UTC with nanoseconds, as the `time` crate
    formats them (crates/daemon/src/time.rs:12-16)."""
    t = time.time() - seconds_ago
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(t)) + f".{int((t % 1) * 1e9):09d}Z"


def env(ok):
    print(json.dumps({"cli_version": VERSION, "protocol": PROTOCOL, "ok": ok}))


# Error envelope and exit codes: crates/cli/src/commands/mod.rs:43-75 and
# crates/cli/src/error.rs:962-985, :1120-1130 (usage errors exit 2).
def fail(code, msg, recover=None, status=1, cls="configuration"):
    err = {"class": cls, "code": code, "msg": msg}
    if recover:
        err["recover"] = recover
    if "--json" in sys.argv:
        print(json.dumps({"cli_version": VERSION, "protocol": PROTOCOL, "err": err}))
    else:
        print(f"error: {msg}", file=sys.stderr)
    sys.exit(status)


def usage(msg):
    fail("cli_usage", msg, status=2)


def state_path(name):
    return os.path.join(STATE, name) if STATE else ""


def load(name, default):
    path = state_path(name)
    if not path or not os.path.isfile(path):
        return default
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def save(name, value):
    """Atomic, so a reader running at the same time never sees half a file."""
    if not STATE:
        return
    os.makedirs(STATE, exist_ok=True)
    tmp = state_path(name) + f".{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(value, handle)
    os.replace(tmp, state_path(name))


def session(sid, name, agent, activity, project, group=None, link=None, branch="", updated=60, subagents=0,
            state="running", runtime="live", created=7200, extra_meta=None):
    meta = {}
    if group:
        meta["companion.group"] = group
    if link:
        provider, kind, lid = link
        meta.update({"work.link.provider": provider, "work.link.kind": kind, "work.link.id": lid,
                     "work.link.url": f"https://github.com/acme/{project}/pull/{lid}" if provider == "github" else f"https://linear.app/acme/issue/{lid}"})
    meta.update(extra_meta or {})
    return {
        "id": sid, "name": name, "agent": agent, "agent_base": agent, "cwd": f"/home/dev/code/{project}",
        "pid": 4242, "cols": 120, "rows": 40, "state": state, "state_source": "detected",
        "activity": activity if state == "running" else None, "runtime": {"state": runtime, "runtime_generation": 1},
        "subagents": [{"id": f"a{i}", "provider": agent, "lifecycle": "running", "revision": 1, "started_at_ms": 0, "updated_at_ms": 0} for i in range(subagents)],
        "project_label": project, "branch": branch, "metadata": meta, "capabilities": {},
        "native_session_id": "n-" + sid, "created_at": ago(created), "updated_at": ago(updated),
    }


