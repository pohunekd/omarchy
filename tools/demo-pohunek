ASSISTANT_ID = "pohunek.context.assistant"
ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")


def under_tmpdir(path):
    """Test files live under the caller's TMPDIR, nowhere else."""
    tmp = os.environ.get("TMPDIR", "")
    if not path or not tmp:
        return False
    return os.path.realpath(path).startswith(os.path.realpath(tmp) + os.sep)


LOG = os.environ.get("DEMO_POHUNEK_LOG", "")
STATE = os.environ.get("DEMO_POHUNEK_STATE", "")
for name, value in (("DEMO_POHUNEK_LOG", LOG), ("DEMO_POHUNEK_STATE", STATE)):
    if value and not under_tmpdir(value):
        print(f"demo-pohunek: {name} must be under TMPDIR", file=sys.stderr)
        sys.exit(2)
STRICT = bool(LOG)
if LOG:
    with open(LOG, "a", encoding="utf-8") as handle:
        handle.write(json.dumps({"argv": sys.argv[1:], "bin": os.path.realpath(__file__)}) + "\n")


def ago(seconds):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - seconds))


def env(ok):
    print(json.dumps({"cli_version": VERSION, "protocol": PROTOCOL, "ok": ok}))


# Error envelope and exit codes: crates/cli/src/commands/mod.rs:52-79 and
# crates/cli/src/error.rs:877-907, :1051-1074 (usage errors exit 2).
def fail(code, msg, recover=None, status=1, cls="configuration"):
    err = {"class": cls, "code": code, "msg": msg}
    if recover:
        err["recover"] = recover
    if "--json" in sys.argv:
        print(json.dumps({"cli_version": VERSION, "protocol": PROTOCOL, "err": err}))
    else:
        print(f"error: {msg}", file=sys.stderr)
    sys.exit(status)


def usage(msg):
    fail("cli_usage", msg, status=2)


def state_path(name):
    return os.path.join(STATE, name) if STATE else ""


def load(name, default):
    path = state_path(name)
    if not path or not os.path.isfile(path):
        return default
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def save(name, value):
    if not STATE:
        return
    os.makedirs(STATE, exist_ok=True)
    with open(state_path(name), "w", encoding="utf-8") as handle:
        json.dump(value, handle)


def session(sid, name, agent, activity, project, group=None, link=None, branch="", updated=60, subagents=0,
            state="running", runtime="live", created=7200, extra_meta=None):
    meta = {}
    if group:
        meta["companion.group"] = group
    if link:
        provider, kind, lid = link
        meta.update({"work.link.provider": provider, "work.link.kind": kind, "work.link.id": lid,
                     "work.link.url": f"https://github.com/acme/{project}/pull/{lid}" if provider == "github" else f"https://linear.app/acme/issue/{lid}"})
    meta.update(extra_meta or {})
    return {
        "id": sid, "name": name, "agent": agent, "agent_base": agent, "cwd": f"/home/dev/code/{project}",
        "pid": 4242, "cols": 120, "rows": 40, "state": state, "state_source": "detected",
        "activity": activity if state == "running" else None, "runtime": {"state": runtime, "runtime_generation": 1},
        "subagents": [{"id": f"a{i}", "provider": agent, "lifecycle": "running", "revision": 1, "started_at_ms": 0, "updated_at_ms": 0} for i in range(subagents)],
        "project_label": project, "branch": branch, "metadata": meta, "capabilities": {},
        "native_session_id": "n-" + sid, "created_at": ago(created), "updated_at": ago(updated),
    }


