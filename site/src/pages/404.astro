---
import Base from '../layouts/Base.astro';
import Bar from '../components/Bar.astro';
import Tile from '../components/Tile.astro';
---
<Base title="Window not found - pohunek for Omarchy" description="This page does not exist.">
	<Bar />
	<main id="main" class="desk">
		<Tile kind="term" title="pohunek - 404" class="lost" labelledby="lost-h" reveal={false}>
			<h1 id="lost-h" class="mono-h"><span class="prompt" aria-hidden="true">&gt;</span> No window with that address</h1>
			<p>Nothing is tiled here. <a href={import.meta.env.BASE_URL}>Back to the overview</a>.</p>
		</Tile>
	</main>
</Base>
